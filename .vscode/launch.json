{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar Frontend Local",
            "type": "chrome",
            "request": "launch",
            /* Usamos 'file' en lugar de 'url' para evitar errores de conexión 
               si el servidor local no está activo. 
            */
            "file": "${workspaceFolder}/index.html",
            "webRoot": "${workspaceFolder}",
            /* Mantenemos el path mapping para que los breakpoints 
               en los archivos .js funcionen correctamente. 
            */
            "sourceMaps": true
        }
    ]
}